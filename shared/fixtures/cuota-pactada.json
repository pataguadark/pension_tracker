    { "nombre": "factor negativo", "entrada": { "utmFactor": -3, "utmValor": 70000 }, "esperado": { "error": true } },
    { "nombre": "utm cero", "entrada": { "utmFactor": 3, "utmValor": 0 }, "esperado": { "error": true } },
    { "nombre": "utm negativa", "entrada": { "utmFactor": 3, "utmValor": -70000 }, "esperado": { "error": true } },
    { "nombre": "factor NaN", "entrada": { "utmFactor": "NaN", "utmValor": 70000 }, "esperado": { "error": true } },
    { "nombre": "factor infinito", "entrada": { "utmFactor": "Infinity", "utmValor": 70000 }, "esperado": { "error": true } },
    { "nombre": "utm NaN", "entrada": { "utmFactor": 3, "utmValor": "NaN" }, "esperado": { "error": true } },
    { "nombre": "utm infinita", "entrada": { "utmFactor": 3, "utmValor": "Infinity" }, "esperado": { "error": true } }
