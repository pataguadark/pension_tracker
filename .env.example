# Variables de entorno de Pensión Tracker (todas opcionales)
# Copiar este archivo a .env y ajustar solo si lo necesitas.
#
# La SECRET_KEY se autogenera y persiste sola en el directorio de datos
# del usuario (ver src/pensiontracker/config.py); no hace falta definirla.

# Puerto del servidor (por defecto 7040)
PT_PORT=7040

# Activa el modo debug de Flask (por defecto apagado)
PT_DEBUG=0
